{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "../../apps/web/.next/types/**/*.ts",
    "../../dist/apps/web/.next/types/**/*.ts",
    "index.d.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "jest.config.ts",
    "jest.config.cts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/components/admin/sows/pm/**/*",
    "src/components/admin/sows/TemplateBuilder.tsx",
    "src/components/admin/sows/SowEditorPage.tsx",
    "src/components/admin/sows/builder/Canvas.tsx",
    "src/components/admin/sows/builder/FieldPalette.tsx",
    "src/components/admin/sows/builder/PropertyPanel.tsx",
    "src/components/admin/sows/builder/ConditionalLogicEditor.tsx",
    "src/components/admin/sows/builder/LivePreview.tsx",
    "src/components/admin/sows/builder/ValidationEditor.tsx",
    "src/components/admin/sows/builder/FormValuesDocument.tsx",
    "src/components/admin/sows/builder/widgets.tsx",
    "src/components/admin/sows/builder/treeOps.ts",
    "src/components/admin/sows/builder/conditionalEngine.ts",
    "src/components/admin/sows/builder/FormulaEditor.tsx",
    "src/components/admin/sows/builder/TemplateToolbar.tsx",
    "src/components/admin/sows/builder/mockDirectory.ts",
    "src/components/admin/sows/builder/TemplateBuilder.tsx"
  ]
}
